# ============================================================================
# Safe Upload Directory Restrictions (cPanel Apache / LiteSpeed)
# Prevents execution of PHP, CGI, Perl, Python, or HTML scripts in /uploads/
# ============================================================================

Options -Indexes -ExecCGI

<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml|htm|html|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
